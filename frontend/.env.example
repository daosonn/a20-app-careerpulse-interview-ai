# ============================================================
# CareerPulse — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Base URL of the FastAPI backend (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production:
# VITE_API_BASE_URL=https://your-backend.vercel.app

# Firebase config is read from frontend/firebase-applet-config.json
# (downloaded from Firebase Console → Project Settings → Your apps → Config)
# Do not put Firebase credentials in this file.
