# ============================================================
# CareerPulse — Backend Environment Variables
# Copy this file to .env and fill in your values.
# The backend loads this from the project root.
# ============================================================

# ------------------------------------------------------------
# Required
# ------------------------------------------------------------

# OpenAI — chat completions (gpt-4o-mini), Whisper STT, TTS
OPENAI_API_KEY=sk-...

# Jina — v4 embeddings for the RAG question bank
JINA_API_KEY=jina_...

# Firebase — project ID used to verify ID tokens from the frontend
# Accepts either FIREBASE_PROJECT_ID or GOOGLE_CLOUD_PROJECT
FIREBASE_PROJECT_ID=your-firebase-project-id

# ------------------------------------------------------------
# Database (optional — defaults to local SQLite)
# ------------------------------------------------------------

# Leave blank for SQLite at database/sql/interview_coach.db
# Set to a Postgres URL for production (Neon / Supabase / Vercel Postgres)
DATABASE_URL=

# ------------------------------------------------------------
# CORS (optional)
# ------------------------------------------------------------

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# TTS — Text-to-Speech (optional)
# ------------------------------------------------------------

# Provider: auto | openai | google
# "auto" tries OpenAI first, falls back to Google
INTERVIEW_TTS_PROVIDER=auto

# OpenAI TTS model
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Google TTS model (only used when INTERVIEW_TTS_PROVIDER=google or auto fallback)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_API_KEY=

# ------------------------------------------------------------
# LangGraph checkpointing (optional)
# ------------------------------------------------------------

# Custom path for the LangGraph SQLite checkpoint file
# Defaults to database/sql/langgraph_checkpoints.sqlite
LANGGRAPH_CHECKPOINT_SQLITE_PATH=

# ------------------------------------------------------------
# Session tracing (optional)
# ------------------------------------------------------------

# Path for per-session trace JSONL logs
INTERVIEW_TRACE_LOG_PATH=

# Max characters to record per text field in traces (default: 6000)
INTERVIEW_TRACE_MAX_TEXT_CHARS=6000

# ------------------------------------------------------------
# RAG data ingestion (optional)
# ------------------------------------------------------------

# Stack Exchange API key for the interview Q&A crawler
STACK_EXCHANGE_KEY=

# ------------------------------------------------------------
# AI activity logging — required if using setup_hooks.sh
# ------------------------------------------------------------

AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
